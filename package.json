{
  "name": "fortuna",
  "version": "1.0.0",
  "description": "Personal financial management",
  "main": "dist/fortuna.js",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "build": "npm run build:renderer && tsup && node scripts/copy-renderer.mjs",
    "build:renderer": "vite build --config src/renderer/vite.config.mjs",
    "dev": "concurrently -k -n renderer,electron -c cyan,green \"npm run dev:renderer\" \"npm run dev:electron\"",
    "dev:renderer": "vite --config src/renderer/vite.config.mjs",
    "dev:electron": "wait-on tcp:127.0.0.1:5173 && cross-env NODE_ENV=dev NODE_OPTIONS=--import=tsx electron --no-sandbox --disable-setuid-sandbox src/main.ts",
    "postinstall": "npm run rebuild:electron",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "start": "electron --no-sandbox --disable-setuid-sandbox dist/fortuna.js",
    "check": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "files": [
    "dist"
  ],
  "author": "Fabiano Pires (Mineot)",
  "homepage": "https://github.com/mineot/fortuna#readme",
  "bugs": {
    "url": "https://github.com/mineot/fortuna/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mineot/fortuna.git"
  },
  "keywords": [
    "personal",
    "financial",
    "management"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.0",
    "@electron/rebuild": "^4.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.5.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^17.4.0",
    "prettier": "^3.8.1",
    "cross-env": "^7.0.3",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vite": "^7.1.7",
    "wait-on": "^8.0.5"
  },
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "electron": "^41.2.0",
    "kysely": "^0.28.15",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4"
  }
}
