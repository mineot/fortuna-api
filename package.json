{
  "name": "fortuna",
  "version": "1.0.0",
  "description": "",
  "main": "dist/bundle.js",
  "type": "commonjs",
  "license": "Apache-2.0",
  "bin": {
    "fortuna": "dist/fortuna.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:core": "tsup",
    "build:ui": "npm --prefix ui run build -- --base-href ./",
    "build:ui:copy": "node scripts/copy-ui.cjs",
    "build": "npm run build:core && npm run build:ui && npm run build:ui:copy",
    "dev:electron": "npm run build && wait-on tcp:4200 && electron . --no-sandbox",
    "dev:ui": "npm --prefix ui run start",
    "dev": "NODE_ENV=dev concurrently \"npm run dev:ui\" \"npm run dev:electron\"",
    "preview": "node dist/fortuna.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepack": "npm run build"
  },
  "author": "Fabiano Pires (Mineot)",
  "keywords": [],
  "homepage": "https://github.com/mineot/fortuna#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mineot/fortuna.git"
  },
  "bugs": {
    "url": "https://github.com/mineot/fortuna/issues"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.5.0",
    "concurrently": "^9.2.1",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1",
    "wait-on": "^9.0.4"
  },
  "dependencies": {
    "electron": "^41.0.3"
  }
}
