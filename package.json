{
  "name": "fortuna",
  "version": "1.0.0",
  "description": "Personal financial management",
  "main": "dist/fortuna.js",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/fortuna.js",
    "check": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "files": [
    "dist"
  ],
  "author": "Fabiano Pires (Mineot)",
  "homepage": "https://github.com/mineot/fortuna#readme",
  "bugs": {
    "url": "https://github.com/mineot/fortuna/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mineot/fortuna.git"
  },
  "keywords": [
    "personal",
    "financial",
    "management"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@typescript-eslint/eslint-plugin": "^8.30.1",
    "@typescript-eslint/parser": "^8.30.1",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^10.1.2",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "tsup": "^8.5.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
