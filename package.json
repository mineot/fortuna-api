{
  "name": "fortuna",
  "version": "1.0.0",
  "private": true,
  "description": "Personal financial management.",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "dev": "FORTUNA_ENV=dev tsx src/main.ts",
    "build": "rm -rf dist && tsup",
    "start": "node dist/fortuna.js",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "keywords": [
    "finance",
    "cli",
    "angular",
    "hono",
    "sqlite",
    "kysely",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "^1.19.11",
    "better-sqlite3": "^12.6.2",
    "commander": "^14.0.3",
    "hono": "^4.12.5",
    "inquirer": "^13.3.0",
    "kysely": "^0.28.11"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.5.2",
    "eslint": "^10.0.3",
    "prettier": "^3.8.1",
    "tsup": "^8.5.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0"
  }
}
