# INSTALL
# Copy this file to the ./.git/hooks folder
# Remove all comments from the script
# And give execution permission chmod +x

#!/bin/bash
# Interactive hook to build commit message in the format:
# <emoji> <type>/<scope>: <message>
# Example: :sparkles: feat/login: adds login screen

COMMIT_MSG_FILE="$1"
COMMIT_SOURCE="$2"

# Do not touch merge commits (automatic message)
if [ "$COMMIT_SOURCE" = "merge" ]; then
  exit 0
fi

# Ensures input/output are connected to the real terminal
# (git runs hooks with stdin closed)
if [ -e /dev/tty ]; then
  exec < /dev/tty
  exec > /dev/tty
fi

echo
echo "=== Commit assistant (gitmoji) ==="

# 1. Choose emoji
echo "Choose the emoji:"
echo "  1) :sparkles:  (feat: Introducing a new functionality or capability.)"
echo "  2) :bug:       (fix: Correcting faulty behavior or unexpected issues.)"
echo "  3) :memo:      (docs: Updating or adding project documentation.)"
echo "  4) :wrench:    (chore: Project maintenance work)"
echo "  5) :recycle:   (refactor: Internal code restructuring without changing behavior.)"
echo "  6) :art:       (refinement: Improving code readability and overall quality.)"
echo "  7) :fire:      (cleanup: Removing obsolete or unnecessary code.)"
echo "  8) :rocket:    (general: General-purpose updates not tied to a specific category.)"
echo "  9) Type manually (ex: :fire:)"
read -p "Option [1-9]: " EMOJI_OPT

case "$EMOJI_OPT" in
  1|"") EMOJI=":sparkles:" ;;
  2)    EMOJI=":bug:" ;;
  3)    EMOJI=":memo:" ;;
  4)    EMOJI=":wrench:" ;;
  5)    EMOJI=":recycle:" ;;
  6)    EMOJI=":art:" ;;
  7)    EMOJI=":fire:" ;;
  8)    EMOJI=":rocket:" ;;
  9)    read -p "Type the gitmoji (ex: :fire:): " EMOJI ;;
  *)    echo "Invalid option, using :rocket:"; EMOJI=":rocket:" ;;
esac

# 2. Type (feat/fix/docs/chore/etc)
read -p "Type (ex: feat, fix, docs, etc...) [feat]: " TYPE
TYPE=${TYPE:-feat}

# 3. Scope (login, user-auth, profile, etc)
read -p "Scope (ex: login, user-auth) [optional]: " SCOPE

# 4. Commit message
read -p "Commit message: " MESSAGE

# Build prefix
PREFIX="${EMOJI} ${TYPE}"
if [ -n "$SCOPE" ]; then
  PREFIX="${PREFIX}/${SCOPE}"
fi

FINAL_LINE="${PREFIX}: ${MESSAGE}"

# Write the message to the commit file (replaces anything prior)
echo "$FINAL_LINE" > "$COMMIT_MSG_FILE"

echo
echo "Generated commit message:"
echo "  $FINAL_LINE"
echo
echo "If the editor opens (nano/vim/etc), the message will already be ready there."
