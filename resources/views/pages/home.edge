@layout()
  <div class="p-4 p-md-5 mb-4 bg-body border rounded-3">
    <h1 class="display-6 fw-semibold">It works - welcome to the simplicity of a Hypermedia app</h1>
    <p class="lead mb-0">A lightweight foundation for building modern web interfaces - straightforward, flexible, and true to the web's core simplicity.</p>
  </div>

  <div class="row g-3">
    <div class="col-12 col-md-4">
      <a class="card h-100 text-decoration-none text-body" href="https://insiders.adonisjs.com/docs/v7-alpha/introduction" target="_blank">
        <div class="card-body">
          <h3 class="h5">Official Docs ›</h3>
          <p class="mb-0 text-body-secondary">Comprehensive reference for building with AdonisJS</p>
        </div>
      </a>
    </div>
    <div class="col-12 col-md-4">
      <a class="card h-100 text-decoration-none text-body" href="https://adocasts.com/" target="_blank">
        <div class="card-body">
          <h3 class="h5">Adocasts ›</h3>
          <p class="mb-0 text-body-secondary">Guided video tutorials for everyday development</p>
        </div>
      </a>
    </div>
    <div class="col-12 col-md-4">
      <a class="card h-100 text-decoration-none text-body" href="https://discord.gg/vDcEjq6" target="_blank">
        <div class="card-body">
          <h3 class="h5">Discord ›</h3>
          <p class="mb-0 text-body-secondary">Connect with developers building with AdonisJS every day</p>
        </div>
      </a>
    </div>
  </div>
@end
