{
  "name": "@repo/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -b tsconfig.json --force",
    "dev": "tsup src/index.ts --format esm --sourcemap --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo \"No lint configured for @repo/shared yet\"",
    "test": "tsx --test test/**/*.test.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "kysely": "^0.28.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "tsx": "^4.21.0"
  }
}
