{
  "name": "@repo/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format esm --sourcemap --minify --clean && tsc -p tsconfig.json --emitDeclarationOnly",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx src/migrations/index.ts",
    "seed": "tsx src/seeds/index.ts",
    "lint": "echo \"No lint configured for @repo/database yet\"",
    "test": "echo \"No tests configured for @repo/database yet\"",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@repo/shared": "workspace:*",
    "better-sqlite3": "^12.10.0",
    "kysely": "^0.28.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.7.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0"
  }
}
