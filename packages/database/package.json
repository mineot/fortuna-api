{
  "name": "@repo/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -b tsconfig.json --force",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx src/migrations/index.ts",
    "migrate:status": "tsx src/migrations/index.ts status",
    "seed": "tsx src/seeds/index.ts",
    "seed:account-types": "tsx src/seeds/index.ts account-types",
    "seed:categories": "tsx src/seeds/index.ts categories",
    "lint": "echo \"No lint configured for @repo/database yet\"",
    "test": "tsx --test test/**/*.test.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@repo/shared": "workspace:*",
    "kysely": "^0.28.8"
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0"
  }
}
