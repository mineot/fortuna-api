# Allowed values:
# DEV  -> local defaults are allowed
# PROD -> required variables must be explicitly set
FORTUNA_ENV=DEV

# Database (existing project rule):
# DEV  -> if empty, uses ./dev.db at project root
# PROD -> if empty, fallback is ~/.fortuna/fortuna.db
# PROD -> you can explicitly set a full file path
FORTUNA_DB=

# Web/API runtime configuration
# DEV defaults:
# FORTUNA_WEB_PORT=4200
# FORTUNA_API_PORT=3000
# FORTUNA_WEB_URL=http://localhost:4200
# FORTUNA_API_BASE_URL=http://localhost:3000/api/v1
#
# PROD required (must not be empty; app should fail on startup if missing):
# FORTUNA_WEB_PORT
# FORTUNA_API_PORT
# FORTUNA_WEB_URL
# FORTUNA_API_BASE_URL
# FORTUNA_JWT_SECRET
#
# Optional (DEV/PROD): JWT access token TTL (default: 1h)
# FORTUNA_JWT_ACCESS_TOKEN_EXPIRES_IN
FORTUNA_WEB_PORT=4200
FORTUNA_API_PORT=3000
FORTUNA_WEB_URL=http://localhost:4200
FORTUNA_API_BASE_URL=http://localhost:3000/api/v1
FORTUNA_JWT_SECRET=change-me
FORTUNA_JWT_ACCESS_TOKEN_EXPIRES_IN=1h
